# LLM Wiki CLI — Environment Variables
#
# This project is primarily config-file based. Most settings live in:
#   - .kimi-code/config.json (workspace defaults)
#   - wikis/<slug>/config.json (wiki-specific config)
#
# The current MVP reads the LLM provider and API key from the
# .kimi-code/config.json file. You can use this .env file to keep secrets
# out of version control, then copy the values into .kimi-code/config.json
# when running sample or full ingestion.
#
# Example .kimi-code/config.json snippet:
#
#   {
#     "llm": {
#       "enabled": true,
#       "provider": "openai",
#       "model": "gpt-4o",
#       "apiKey": "<paste from .env>",
#       "baseUrl": "https://api.openai.com/v1"
#     }
#   }
#
# Do NOT commit this file or .kimi-code/config.json to source control.

# Optional: OpenAI API key for LLM-assisted structure discovery and drafting.
OPENAI_API_KEY=sk-...

# Optional: Anthropic API key for Claude-based LLM assistance.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Kimi (Moonshot AI) API key for LLM-assisted structure discovery and drafting.
KIMI_API_KEY=sk-kimi-...

# Optional: Kimi API base URL. Default is https://api.kimi.com/coding
# KIMI_BASE_URL=https://api.kimi.com/coding

# Optional: override the default LLM provider and model.
# Supported providers: openai, anthropic, openai-compatible, kimi, test
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Optional: override the base URL for an OpenAI-compatible provider.
# LLM_BASE_URL=https://api.openai.com/v1
